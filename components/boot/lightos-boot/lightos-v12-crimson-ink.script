current = 16;
last_index = -1;
sprite = Sprite(frames[current]);
sprite.SetZ(100);

fun refresh_callback() {
    if (current != last_index) {
        sprite.SetImage(frames[current]);
        last_index = current;
    }
    sprite.SetPosition(
        (Window.GetWidth() - 360) / 2,
        (Window.GetHeight() - 358) / 2,
        100
    );
    if (current < 88) {
        current += 2;
        if (current > 88) current = 88;
    } else {
        current++;
        if (current >= 120) current = 88;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
