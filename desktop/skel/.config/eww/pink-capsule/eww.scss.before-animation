* {
  all: unset;
  font-family: "LightOSNew12";
  font-size: 12px;
  font-weight: bold;
}

window {
  background: transparent;
}

.capsule {
  background: rgba(180, 116, 171, 0.94);
  border: 1px solid rgba(255, 207, 244, 0.7);
  border-radius: 100px;
  padding: 4px 12px;
  min-height: 25px;
  color: #fff1fa;
  box-shadow: 0 0 12px rgba(255, 120, 215, 0.55);
  transition: background-color 350ms ease;
}

.capsule:hover {
  background: rgba(202, 135, 190, 0.97);
}

button {
  padding: 3px 6px;
  border-radius: 20px;
  color: #fff3fc;
  transition: background-color 250ms ease;
}

button:hover {
  background: rgba(255, 220, 246, 0.3);
}

.heart {
  color: #ffd1f1;
  font-size: 18px;
  padding: 0 3px;
  text-shadow: 0 0 8px #ff69cb;
}

.disc {
  color: #ffecfb;
  font-size: 19px;
  min-width: 23px;
}

.battery {
  color: #fff2fb;
  font-size: 11px;
  border-bottom: 2px solid #8defff;
}

.clock {
  font-size: 14px;
  color: white;
  text-shadow: 0 0 5px #ffe5fa;
}

.module {
  font-size: 15px;
  min-width: 17px;
}

.small-info {
  color: #ffe1f6;
  padding-right: 4px;
}

.popup {
  background: rgba(48, 31, 57, 0.97);
  border: 1px solid #ef9bd7;
  border-radius: 23px;
  padding: 18px;
  color: #fff0fb;
}

.popup-title {
  font-size: 15px;
  color: #ffbce9;
}

.song-title {
  font-size: 14px;
  color: white;
}

.song-artist {
  color: #dfb8d8;
}

.popup button {
  background: rgba(255, 175, 230, 0.17);
  padding: 6px 12px;
  border-radius: 12px;
}

.popup button:hover {
  background: rgba(255, 175, 230, 0.38);
}

.close {
  color: #ffc4e9;
}

calendar {
  color: #ffe6f8;
}
