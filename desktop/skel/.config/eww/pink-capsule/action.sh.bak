#!/usr/bin/env bash

D="$HOME/.config/eww/pink-capsule"

case "$1" in
  calendar|music|wifi|bluetooth)
    eww -c "$D" open --toggle "$1-popup"
    ;;
  settings)
    "$HOME/.config/Light/bin/lightsettings" &
    ;;
  network-settings)
    "$HOME/.config/Light/bin/lightsettings" network &
    ;;
  bluetooth-settings)
    if [ -x "$HOME/.config/rofi/scripts/bluetooth.sh" ]; then
      "$HOME/.config/rofi/scripts/bluetooth.sh" &
    elif command -v blueman-manager >/dev/null; then
      blueman-manager &
    fi
    ;;
  bluetooth-toggle)
    if bluetoothctl show | grep -q 'Powered: yes'; then
      bluetoothctl power off
    else
      bluetoothctl power on
    fi
    ;;
  wifi-toggle)
    if nmcli radio wifi | grep -q enabled; then
      nmcli radio wifi off
    else
      nmcli radio wifi on
    fi
    ;;
  notifications)
    swaync-client -t -sw
    ;;
  volume-mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
  play)
    playerctl play-pause 2>/dev/null || true
    ;;
  next)
    playerctl next 2>/dev/null || true
    ;;
  prev)
    playerctl previous 2>/dev/null || true
    ;;
  workspace-next)
    hyprctl dispatch workspace e+1
    ;;
  workspace-prev)
    hyprctl dispatch workspace e-1
    ;;
esac
