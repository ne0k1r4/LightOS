(defvar expanded false)
(defpoll clock :interval "1s" `~/.config/eww/pink-capsule/status.sh clock`)
(defpoll today :interval "30s" `~/.config/eww/pink-capsule/status.sh date`)
(defpoll battery :interval "10s" `~/.config/eww/pink-capsule/status.sh battery`)
(defpoll wifi-name :interval "5s" `~/.config/eww/pink-capsule/status.sh wifi`)
(defpoll bt-status :interval "5s" `~/.config/eww/pink-capsule/status.sh bluetooth`)
(defpoll volume :interval "2s" `~/.config/eww/pink-capsule/status.sh volume`)
(defpoll brightness :interval "3s" `~/.config/eww/pink-capsule/status.sh brightness`)
(defpoll song-title :interval "2s" `~/.config/eww/pink-capsule/status.sh title`)
(defpoll song-artist :interval "2s" `~/.config/eww/pink-capsule/status.sh artist`)
(defpoll song-status :interval "1s" `~/.config/eww/pink-capsule/status.sh playing`)
(defpoll disc :interval "1s" `~/.config/eww/pink-capsule/status.sh disc`)
(defpoll glow-phase :interval "500ms" `date +%S%N | cut -c 1-2` )
(defpoll workspace :interval "2s" `~/.config/eww/pink-capsule/status.sh workspace`)
(defpoll recording :interval "2s" `~/.config/eww/pink-capsule/status.sh recording`)

(defwidget iconbutton [file action]
  (button :class "icon-button" :onclick action
    (image :path file :image-width 23 :image-height 23)))

(defwidget capsule []
  (eventbox
    :onhover "eww -c ~/.config/eww/pink-capsule update expanded=true"
    :onhoverlost "eww -c ~/.config/eww/pink-capsule update expanded=false"
    (box :class {glow-phase % 2 == 0 ? "capsule breathe" : "capsule"} :orientation "h" :space-evenly false :spacing 4
      (revealer :transition "slideright" :duration "550ms" :reveal expanded
        (box :orientation "h" :space-evenly false :spacing 3
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/lightlogopink3.png" :action "~/.config/eww/pink-capsule/action.sh dashboard")
          (button :onclick "~/.config/eww/pink-capsule/action.sh workspace-prev" "‹")
          (button :onclick "~/.config/eww/pink-capsule/action.sh workspace-next" "WS ${workspace}")
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/wifi-icon35.png" :action "~/.config/eww/pink-capsule/action.sh wifi")
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/bluetooth-icon22.png" :action "~/.config/eww/pink-capsule/action.sh bluetooth")
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/audio-headphones.png" :action "~/.config/eww/pink-capsule/action.sh controls")))
      (button :class "disc" :onclick "~/.config/eww/pink-capsule/action.sh music" disc)
      (label :class {glow-phase % 2 == 0 ? "heart glow" : "heart"} :text "♥")
      (button :class "battery" :onclick "~/.config/eww/pink-capsule/action.sh controls" "BATTERY ${battery}%")
      (button :class "clock" :onclick "~/.config/eww/pink-capsule/action.sh calendar" clock)
      (label :class {glow-phase % 2 == 0 ? "heart glow" : "heart"} :text "♥")
      (revealer :transition "slideleft" :duration "550ms" :reveal expanded
        (box :orientation "h" :space-evenly false :spacing 3
          (button :onclick "~/.config/eww/pink-capsule/action.sh prev" "󰒮")
          (button :onclick "~/.config/eww/pink-capsule/action.sh play" {song-status == "Playing" ? "󰏤" : "󰐊"})
          (button :onclick "~/.config/eww/pink-capsule/action.sh next" "󰒭")
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/alerts.png" :action "~/.config/eww/pink-capsule/action.sh notifications")
          (iconbutton :file "/home/LIGHT/.config/eww/pink-capsule/assets/setting.png" :action "~/.config/eww/pink-capsule/action.sh settings"))))))

(defwindow capsule-window :monitor 0
  :geometry (geometry :x "0px" :y "5px" :width "950px" :height "50px" :anchor "top center")
  :stacking "fg" :exclusive false
  (box :halign "center" :valign "center" (capsule)))

(defwidget music-card []
  (box :class "card" :orientation "v" :spacing 8
    (label :class "heading" :text "ACTIVE MEDIA PLAYER")
    (label :class "song" :text {song-title == "" ? "Nothing playing" : song-title} :limit-width 32)
    (label :class "subtext" :text song-artist :limit-width 35)
    (box :halign "center" :spacing 18
      (button :onclick "~/.config/eww/pink-capsule/action.sh prev" "󰒮")
      (button :onclick "~/.config/eww/pink-capsule/action.sh play" {song-status == "Playing" ? "󰏤" : "󰐊"})
      (button :onclick "~/.config/eww/pink-capsule/action.sh next" "󰒭"))))

(defwidget sliders []
  (box :orientation "v" :spacing 8
    (box :spacing 10
      (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/audio-headphones.png" :image-width 20 :image-height 20)
      (label :text "VOLUME")
      (scale :min 0 :max 100 :value {volume == "" ? 0 : volume} :onchange "~/.config/eww/pink-capsule/action.sh volume {}")
      (label :text "${volume}%"))
    (box :spacing 10
      (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/sun.png" :image-width 20 :image-height 20)
      (label :text "BRIGHTNESS")
      (scale :min 0 :max 100 :value {brightness == "--" ? 0 : brightness} :onchange "~/.config/eww/pink-capsule/action.sh brightness {}")
      (label :text brightness))))

(defwidget control-center []
  (box :class "panel" :orientation "v" :spacing 12
    (box :spacing 8 :homogeneous true
      (button :class "card" :onclick "~/.config/eww/pink-capsule/action.sh wifi"
        (box :spacing 6 (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/wifi-icon35.png" :image-width 24 :image-height 24) (label :text "WI-FI")))
      (button :class "card" :onclick "~/.config/eww/pink-capsule/action.sh bluetooth"
        (box :spacing 6 (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/bluetooth-icon22.png" :image-width 24 :image-height 24) (label :text "BLUETOOTH")))
      (button :class "card" :onclick "~/.config/eww/pink-capsule/action.sh network-settings" "LOCAL / NETWORK"))
    (box :class "card" :spacing 14
      (label :text "RECORDER")
      (button :class "record" :onclick "~/.config/eww/pink-capsule/action.sh recorder" recording))
    (sliders)
    (music-card)
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close controls-popup" "CLOSE")))

(defwidget dashboard []
  (box :class "dashboard" :orientation "v" :spacing 12
    (box :class "nav" :spacing 10 :halign "center"
      (button :onclick "~/.config/eww/pink-capsule/action.sh dashboard" "DASHBOARD")
      (button :onclick "~/.config/eww/pink-capsule/action.sh wallpaper" "WALLPAPER")
      (button :onclick "~/.config/eww/pink-capsule/action.sh settings" "SETTINGS"))
    (box :spacing 12
      (box :orientation "v" :spacing 12 :hexpand true
        (music-card)
        (box :class "card" :orientation "v"
          (label :class "heading" :text "LIGHTOS")
          (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/lightlogopink3.png" :image-width 64 :image-height 64)))
      (box :orientation "v" :spacing 12 :hexpand true
        (box :class "card" :orientation "v"
          (label :class "heading" :text today)
          (calendar))
        (box :class "card" :orientation "v" :spacing 10
          (label :class "heading" :text "SYSTEM")
          (box :spacing 10
            (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/battery-icon34.png" :image-width 25 :image-height 25)
            (label :text "Battery ${battery}%")
            (image :path "/home/LIGHT/.config/eww/pink-capsule/assets/temperature-icon33.png" :image-width 25 :image-height 25))
          (sliders))))
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close dashboard-popup" "CLOSE")))

(defwindow controls-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "420px" :height "510px" :anchor "top center")
  :stacking "fg" :exclusive false (control-center))

(defwindow dashboard-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "760px" :height "540px" :anchor "top center")
  :stacking "fg" :exclusive false (dashboard))

(defwindow calendar-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "340px" :height "370px" :anchor "top center")
  :stacking "fg" :exclusive false
  (box :class "panel" :orientation "v" :spacing 12
    (label :class "heading" :text today)
    (calendar)
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close calendar-popup" "CLOSE")))

(defwindow music-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "380px" :height "210px" :anchor "top center")
  :stacking "fg" :exclusive false
  (box :class "panel" :orientation "v" :spacing 10
    (music-card)
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close music-popup" "CLOSE")))

(defwindow wifi-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "310px" :height "190px" :anchor "top center")
  :stacking "fg" :exclusive false
  (box :class "panel" :orientation "v" :spacing 10
    (label :class "heading" :text "WI-FI")
    (label :text wifi-name)
    (button :onclick "~/.config/eww/pink-capsule/action.sh wifi-toggle" "TOGGLE WI-FI")
    (button :onclick "~/.config/eww/pink-capsule/action.sh network-settings" "NETWORK SETTINGS")
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close wifi-popup" "CLOSE")))

(defwindow bluetooth-popup :monitor 0
  :geometry (geometry :x "0px" :y "60px" :width "310px" :height "190px" :anchor "top center")
  :stacking "fg" :exclusive false
  (box :class "panel" :orientation "v" :spacing 10
    (label :class "heading" :text "BLUETOOTH")
    (label :text bt-status)
    (button :onclick "~/.config/eww/pink-capsule/action.sh bluetooth-toggle" "TOGGLE BLUETOOTH")
    (button :onclick "~/.config/eww/pink-capsule/action.sh bluetooth-settings" "DEVICES")
    (button :class "close" :onclick "eww -c ~/.config/eww/pink-capsule close bluetooth-popup" "CLOSE")))
