@import "wallpaper";
* { all: unset; font-family: "LightOSNew12"; font-size: 12px; font-weight: bold; }
window { background: transparent; }
.capsule { background: rgba($accent, .88); color: $text; border: 1px solid $accent-soft; border-radius: 99px; padding: 4px 13px; min-height: 28px; box-shadow: 0 0 12px rgba($accent-soft,.35); transition: background-color 300ms ease; }
.capsule:hover { background: rgba($accent,.97); }
.capsule.breathe { border-color: $accent-soft; box-shadow: 0 0 20px rgba($accent-soft,.65); }
.heart.glow { color: $text; text-shadow: 0 0 9px $accent-soft; }
button { color: $text; border-radius: 18px; padding: 4px 7px; transition: background-color 220ms ease; }
button:hover { background: rgba($accent-soft,.32); }
.heart { color: $accent-soft; font-size: 18px; padding: 0 3px; }
.disc { font-size: 20px; color: $accent-soft; }
.disc:hover { background: rgba($accent-soft,.25); }
.clock { font-size: 14px; }
.battery { border-bottom: 2px solid $accent-soft; }
.panel, .dashboard { background: rgba($ink,.87); color: $text; border: 1px solid $accent-soft; border-radius: 26px; padding: 18px; box-shadow: 0 0 22px rgba($accent,.35); }
.card, .nav { background: rgba($accent,.32); border: 1px solid rgba($accent-soft,.45); border-radius: 20px; padding: 12px; }
.heading { color: $accent-soft; font-size: 15px; }
.song { font-size: 14px; }
.subtext { opacity: .8; }
.record { background: rgba($accent,.6); }
.close { background: rgba($accent,.4); }
scale trough { background: rgba($accent-deep,.65); min-height: 5px; min-width: 90px; border-radius: 20px; }
scale highlight { background: $accent-soft; border-radius: 20px; }
scale slider { background: $accent-soft; border-radius: 100%; min-width: 12px; min-height: 12px; }
calendar { color: $text; }
calendar:selected { background: $accent-soft; color: $ink; }

/* Motion upgrade: GTK-supported color interpolation and reveal effects */
.capsule {
  transition: background-color 400ms ease-in-out,
              border-color 400ms ease-in-out,
              box-shadow 400ms ease-in-out;
}
.capsule:hover {
  border-color: $accent-soft;
  box-shadow: 0 0 24px rgba($accent-soft,.70),
              inset 0 1px rgba(255,255,255,.35);
}
.heart { min-width: 20px; transition: color 180ms ease-in-out; }
.heart.glow { color: $accent-soft; }
.disc { min-width: 26px; transition: background-color 220ms ease-in-out; }
.icon-button { transition: background-color 240ms ease-in-out; }
.icon-button:hover { background-color: rgba($accent-soft,.35); }

/* LIGHTOS SCREENSHOT-INSPIRED DROPDOWNS — wallpaper-driven colors */
.control-panel, .wide-dashboard {
  background-color: rgba($accent, .72);
  border: 1px solid rgba($accent-soft, .65);
  border-radius: 30px;
  padding: 15px;
  box-shadow: 0 8px 24px rgba($ink, .25);
}
.quick-tile, .recorder-card, .music-card, .slider-card, .dashboard-card, .nav-card {
  background-color: rgba($accent-soft, .16);
  border: 1px solid rgba($accent-soft, .30);
  border-radius: 19px;
  padding: 10px;
  transition: background-color 220ms ease-in-out, border-color 220ms ease-in-out;
}
.quick-tile:hover, .dashboard-card:hover, .music-card:hover {
  background-color: rgba($accent-soft, .29);
  border-color: rgba($accent-soft, .75);
}
.quick-tile { min-height: 56px; }
.tile-label, .eyebrow { font-family: "LightOSNew12"; font-size: 11px; color: $text; }
.record-state { color: $accent-soft; font-size: 13px; }
.record-button, .play-button { background: $accent-soft; color: $ink; border-radius: 100%; padding: 9px; }
.record-button:hover, .play-button:hover { background: $text; color: $ink; }
.music-actions button { font-size: 17px; }
.slider-card scale trough { min-height: 6px; min-width: 175px; border-radius: 15px; background: rgba($ink,.36); }
.slider-card scale highlight { min-height: 6px; background: $accent-soft; border-radius: 15px; }
.slider-card scale slider { min-height: 13px; min-width: 13px; background: $text; border-radius: 100%; }
.nav-card button:hover { background: rgba($accent-soft,.4); }
.control-panel .close, .wide-dashboard .close { background: rgba($ink,.2); padding: 8px; border-radius: 20px; }
