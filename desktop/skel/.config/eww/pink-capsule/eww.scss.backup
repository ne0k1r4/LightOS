* {
  all: unset;
  font-family: "LightOSNew12";
  font-size: 12px;
  font-weight: bold;
}

window {
  background: transparent;
}

.capsule {
  background: rgba(180, 116, 171, 0.94);
  border: 1px solid rgba(255, 207, 244, 0.7);
  border-radius: 100px;
  padding: 4px 12px;
  min-height: 25px;
  color: #fff1fa;
  box-shadow: 0 0 12px rgba(255, 120, 215, 0.55);
  transition: background-color 350ms ease;
}

.capsule:hover {
  background: rgba(202, 135, 190, 0.97);
}

button {
  padding: 3px 6px;
  border-radius: 20px;
  color: #fff3fc;
  transition: background-color 250ms ease;
}

button:hover {
  background: rgba(255, 220, 246, 0.3);
}

.heart {
  color: #ffd1f1;
  font-size: 18px;
  padding: 0 3px;
  text-shadow: 0 0 8px #ff69cb;
}

.disc {
  color: #ffecfb;
  font-size: 19px;
  min-width: 23px;
}

.battery {
  color: #fff2fb;
  font-size: 11px;
  border-bottom: 2px solid #8defff;
}

.clock {
  font-size: 14px;
  color: white;
  text-shadow: 0 0 5px #ffe5fa;
}

.module {
  font-size: 15px;
  min-width: 17px;
}

.small-info {
  color: #ffe1f6;
  padding-right: 4px;
}

.popup {
  background: rgba(48, 31, 57, 0.97);
  border: 1px solid #ef9bd7;
  border-radius: 23px;
  padding: 18px;
  color: #fff0fb;
}

.popup-title {
  font-size: 15px;
  color: #ffbce9;
}

.song-title {
  font-size: 14px;
  color: white;
}

.song-artist {
  color: #dfb8d8;
}

.popup button {
  background: rgba(255, 175, 230, 0.17);
  padding: 6px 12px;
  border-radius: 12px;
}

.popup button:hover {
  background: rgba(255, 175, 230, 0.38);
}

.close {
  color: #ffc4e9;
}

calendar {
  color: #ffe6f8;
}

/* LIGHTOS PINK CAPSULE ANIMATION UPGRADE */

/* Glowing breathing capsule */
@keyframes capsule-glow {
  0% {
    box-shadow: 0 0 5px rgba(255, 105, 210, 0.25);
    background-color: rgba(180, 116, 171, 0.88);
  }
  50% {
    box-shadow: 0 0 22px rgba(255, 105, 210, 0.85);
    background-color: rgba(207, 133, 193, 0.97);
  }
  100% {
    box-shadow: 0 0 5px rgba(255, 105, 210, 0.25);
    background-color: rgba(180, 116, 171, 0.88);
  }
}

.capsule {
  animation: capsule-glow 3s ease-in-out infinite;
  transition: background-color 500ms ease;
}

/* Pulsating hearts */
@keyframes heart-pulse {
  0% {
    color: #ffbce8;
    text-shadow: 0 0 3px #ff75d1;
  }
  50% {
    color: #ffffff;
    text-shadow: 0 0 15px #ff44bd;
  }
  100% {
    color: #ffbce8;
    text-shadow: 0 0 3px #ff75d1;
  }
}

.heart {
  animation: heart-pulse 1.5s ease-in-out infinite;
}

/* Spinning music indicator */
@keyframes disc-spin {
  from {
    -gtk-icon-transform: rotate(0deg);
  }
  to {
    -gtk-icon-transform: rotate(360deg);
  }
}

.disc {
  animation: disc-spin 3s linear infinite;
  color: #ffe3f8;
}

/* Hover highlights */
.module:hover {
  background-color: rgba(255, 210, 244, 0.4);
  color: #ffffff;
  box-shadow: 0 0 10px rgba(255, 135, 225, 0.65);
}

.clock:hover {
  background-color: rgba(255, 200, 240, 0.3);
  color: #ffffff;
}

.battery:hover {
  background-color: rgba(255, 200, 240, 0.25);
}

/* Popup animation attempt */
@keyframes popup-appear {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.popup {
  animation: popup-appear 350ms ease-out;
}
