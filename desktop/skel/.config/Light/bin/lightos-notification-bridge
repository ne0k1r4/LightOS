#!/usr/bin/env python3
"""Observe freedesktop notification calls; SwayNC remains the daemon."""
import os, re, subprocess, threading, sys, json, time
from pathlib import Path
D = str(Path.home()/'.config/eww/pink-capsule')
lock = threading.RLock()
generation = 0

def update(**kw):
    cmd=['eww','-c',D,'update']+[f'{k}={v}' for k,v in kw.items()]
    result=subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode: print(result.stderr.strip(),file=sys.stderr,flush=True)


def lightos_chime():
    import os
    import shutil
    import subprocess

    if os.environ.get("LIGHTOS_NOTICE_SOUND", "1") == "0":
        return

    sound = str(Path.home() /
                ".local/share/lightos-notifications/chime.wav")

    player = shutil.which("paplay") or shutil.which("pw-play")
    if player and Path(sound).is_file():
        subprocess.Popen(
            [player, sound],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )

def show(app,title,body):
    global generation
    with lock:
        generation+=1
        seq=generation
        update(lightos_notice_title=(app+' · '+title)[:65],lightos_notice_body=body[:110],lightos_notice_active='true')
    # Append to the capsule dropdown's local notification cache.
    try:
        history=Path.home()/'.local/state/lightos-notifications/history.json'
        history.parent.mkdir(parents=True,exist_ok=True)
        try: entries=json.loads(history.read_text())
        except (OSError,ValueError): entries=[]
        entries.insert(0,{'title':(app+' · '+title)[:100],'body':body[:300],'time':int(time.time())})
        tmp=history.with_suffix('.tmp')
        tmp.write_text(json.dumps(entries[:30],ensure_ascii=False))
        tmp.replace(history)
    except Exception as exc: print('history:',exc,file=sys.stderr,flush=True)
    lightos_chime()
    def hide():
        with lock:
            if seq==generation: update(lightos_notice_active='false')
    t=threading.Timer(4.0,hide); t.daemon=True; t.start()

def unescape(s):
    return re.sub(r'\\(["\\nrt])',lambda m:{'n':'\n','r':' ','t':' ','"':'"','\\':'\\'}[m.group(1)],s)

def main():
    cmd=['dbus-monitor','--session',"type='method_call',interface='org.freedesktop.Notifications',member='Notify'"]
    while True:
        p=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,bufsize=1)
        active=False; args=[]
        for line in p.stdout:
            if 'member=Notify' in line:
                active=True; args=[]; continue
            if not active: continue
            # Top-level D-Bus strings have three spaces; array/hint strings are nested.
            m=re.match(r'^   string "((?:\\.|[^"\\])*)"\s*$',line)
            if m:
                args.append(unescape(m.group(1)))
                if len(args)==4:
                    show(args[0],args[2],args[3]); active=False
        print('dbus-monitor exited; retrying',file=sys.stderr,flush=True)
        import time; time.sleep(2)
if __name__=='__main__': main()
